# ============================================================
# .gitignore - 赫拉克勒斯协议（火星基地多智能体文字剧情沙盒游戏）
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---- 虚拟环境 ----
venv/
.venv/
env/
.env/
ENV/

# ---- 环境变量 / 密钥（绝对不能提交）----
.env
.env.local
.env.*.local
*.key
secrets.json

# ---- 运行时数据（运行时生成，不入库）----
# ChromaDB 向量数据库（任何路径下）
chroma_db/
**/chroma_db/
# SQLite 数据库（所有变体）
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.db
# 检查点文件
checkpoints.sqlite
backend/data/checkpoints.sqlite

# ---- 测试 / 覆盖率 ----
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# 测试运行产物（每次跑测试自动重新生成，不入库）
tests/playthrough_log.json
tests/playthrough_report.md

# ---- 前端 ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 ----
*.log
logs/

# ---- 临时文件 ----
*.tmp
*.bak
*.orig
